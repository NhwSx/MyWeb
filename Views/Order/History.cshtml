@model List<MyWebShop.Models.Entities.Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng của tôi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Lịch sử đơn hàng
            </h3>
            <p class="text-muted small mb-0">Theo dõi các đơn hàng bạn đã đặt tại TechZone</p>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="bi bi-plus-lg me-1"></i> Đặt thêm sản phẩm
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-3 gap-2">
                        <div>
                            <span class="fw-bold text-primary fs-6">@order.OrderCode</span>
                            <span class="text-muted small ms-2">Ngày đặt: @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @order.StatusBadgeClass px-3 py-2 rounded-pill">
                                @order.StatusDisplayName
                            </span>
                        </div>
                    </div>

                    <!-- Items Preview -->
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var item in order.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(item.ProductImageUrl ?? "/images/default-product.png")" alt="@item.ProductName" class="rounded object-fit-cover border" style="width: 52px; height: 52px;" />
                                    <div>
                                        <div class="fw-semibold small">@item.ProductName</div>
                                        <div class="text-muted small">SL: @item.Quantity × @item.UnitPrice.ToString("#,##0")₫</div>
                                    </div>
                                </div>
                                <div class="fw-bold text-danger small">@item.TotalPrice.ToString("#,##0")₫</div>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top gap-2">
                        <div class="small">
                            Phương thức: <strong>@order.PaymentMethod</strong>
                            <span class="ms-2">| Trạng thái TT: <span class="badge bg-light text-dark border">@order.PaymentStatusDisplayName</span></span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <span class="text-muted small">Tổng tiền:</span>
                                <strong class="fs-5 text-danger fw-bold ms-1">@order.TotalAmount.ToString("#,##0")₫</strong>
                            </div>
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold">
                                Xem chi tiết <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm p-5 rounded-4 text-center bg-white my-4">
            <i class="bi bi-bag-x text-muted mb-3" style="font-size: 3.5rem;"></i>
            <h5 class="fw-bold mb-2">Bạn chưa có đơn hàng nào</h5>
            <p class="text-muted small mb-4">Các đơn hàng của bạn sẽ được hiển thị và cập nhật theo dõi tại đây</p>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill">
                    Mua sắm ngay
                </a>
            </div>
        </div>
    }
</div>
