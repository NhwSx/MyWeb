@model MyWebShop.Models.Entities.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng " + Model.OrderCode;
    int stepNumber = (int)Model.Status;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Order" asp-action="History" class="text-decoration-none">Lịch sử đơn hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.OrderCode</li>
        </ol>
    </nav>

    <!-- Header bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold mb-1">
                    Đơn hàng: <span class="text-primary">@Model.OrderCode</span>
                </h4>
                <span class="text-muted small">Thời gian đặt: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge @Model.StatusBadgeClass px-3 py-2 fs-6 rounded-pill">
                    @Model.StatusDisplayName
                </span>

                @if (Model.Status == MyWebShop.Models.Entities.OrderStatus.Pending || Model.Status == MyWebShop.Models.Entities.OrderStatus.Confirmed)
                {
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            <i class="bi bi-x-circle me-1"></i> Hủy đơn hàng
                        </button>
                    </form>
                }
            </div>
        </div>

        <!-- Tracking Timeline -->
        @if (Model.Status != MyWebShop.Models.Entities.OrderStatus.Cancelled)
        {
            <div class="order-timeline mt-4">
                <div class="timeline-step @(stepNumber >= 0 ? "completed" : "")">
                    <div class="timeline-icon"><i class="bi bi-check-lg"></i></div>
                    <div class="timeline-label">Chờ xác nhận</div>
                </div>
                <div class="timeline-step @(stepNumber >= 1 ? (stepNumber == 1 ? "active" : "completed") : "")">
                    <div class="timeline-icon"><i class="bi bi-patch-check"></i></div>
                    <div class="timeline-label">Đã xác nhận</div>
                </div>
                <div class="timeline-step @(stepNumber >= 2 ? (stepNumber == 2 ? "active" : "completed") : "")">
                    <div class="timeline-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="timeline-label">Đang chuẩn bị</div>
                </div>
                <div class="timeline-step @(stepNumber >= 3 ? (stepNumber == 3 ? "active" : "completed") : "")">
                    <div class="timeline-icon"><i class="bi bi-truck"></i></div>
                    <div class="timeline-label">Đang giao hàng</div>
                </div>
                <div class="timeline-step @(stepNumber >= 4 ? "completed" : "")">
                    <div class="timeline-icon"><i class="bi bi-house-check"></i></div>
                    <div class="timeline-label">Đã giao</div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-danger rounded-3 mt-4 mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-x-circle-fill fs-5"></i>
                <span>Đơn hàng này đã bị hủy. Hàng hóa đã được hoàn lại về kho.</span>
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Products list -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold mb-3 pb-2 border-bottom">Danh sách sản phẩm</h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 border rounded-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(item.ProductImageUrl ?? "/images/default-product.png")" alt="@item.ProductName" class="rounded object-fit-cover border" style="width: 58px; height: 58px;" />
                                <div>
                                    <div class="fw-semibold small">@item.ProductName</div>
                                    <div class="text-muted small">Đơn giá: @item.UnitPrice.ToString("#,##0")₫ × @item.Quantity</div>
                                </div>
                            </div>
                            <div class="fw-bold text-danger">@item.TotalPrice.ToString("#,##0")₫</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Information Summary -->
        <div class="col-lg-4">
            <!-- Shipping Info -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h6 class="fw-bold mb-3 pb-2 border-bottom"><i class="bi bi-geo-alt text-danger me-1"></i> Địa chỉ nhận hàng</h6>
                <div class="fw-bold text-dark small mb-1">@Model.CustomerName</div>
                <div class="text-muted small mb-1"><i class="bi bi-telephone me-1"></i>@Model.CustomerPhone</div>
                <div class="text-muted small mb-1"><i class="bi bi-envelope me-1"></i>@Model.CustomerEmail</div>
                <div class="text-secondary small mt-2">
                    <i class="bi bi-house-door me-1"></i>@Model.ShippingAddress, @Model.WardDistrict, @Model.ProvinceCity
                </div>
                @if (!string.IsNullOrEmpty(Model.OrderNotes))
                {
                    <div class="small bg-light p-2 rounded mt-2 text-muted">
                        <em>Ghi chú: @Model.OrderNotes</em>
                    </div>
                }
            </div>

            <!-- Payment and Costs -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold mb-3 pb-2 border-bottom"><i class="bi bi-receipt text-primary me-1"></i> Thanh toán</h6>

                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-secondary">Phương thức:</span>
                    <strong>@Model.PaymentMethod</strong>
                </div>

                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-secondary">Trạng thái:</span>
                    <span class="badge @(Model.PaymentStatus == MyWebShop.Models.Entities.PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark")">
                        @Model.PaymentStatusDisplayName
                    </span>
                </div>

                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-secondary">Tiền hàng:</span>
                    <span>@Model.SubTotal.ToString("#,##0")₫</span>
                </div>

                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-secondary">Phí vận chuyển:</span>
                    <span>@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("#,##0") + "₫")</span>
                </div>

                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 small text-success">
                        <span>Giảm giá:</span>
                        <span>-@Model.DiscountAmount.ToString("#,##0")₫</span>
                    </div>
                }

                <hr class="my-2">

                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Tổng thanh toán:</span>
                    <strong class="fs-5 text-danger fw-bold">@Model.TotalAmount.ToString("#,##0")₫</strong>
                </div>
            </div>
        </div>
    </div>
</div>
