@model MyWebShop.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            <i class="bi bi-shield-check text-primary me-2"></i>Thanh toán đơn hàng
        </h3>
        <p class="text-muted small">Vui lòng kiểm tra kỹ thông tin nhận hàng và phương thức thanh toán</p>
    </div>

    <form asp-action="PlaceOrder" method="post" id="checkoutForm" onsubmit="handleCheckoutSubmit(event)">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DirectProductId" />
        <input type="hidden" asp-for="DirectQuantity" />

        <div class="row g-4">
            <!-- Left: Delivery Address & Payment Method -->
            <div class="col-lg-7">
                <!-- Address Section -->
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom">
                        <i class="bi bi-geo-alt-fill text-danger me-2"></i>Thông tin nhận hàng
                    </h5>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label small fw-semibold">Họ và tên người nhận <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Nguyễn Văn A" required />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerPhone" class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="CustomerPhone" class="form-control" placeholder="0901234567" required />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CustomerEmail" class="form-label small fw-semibold">Địa chỉ Email (Nhận mã đơn hàng) <span class="text-danger">*</span></label>
                            <input asp-for="CustomerEmail" class="form-control" placeholder="name@example.com" required />
                            <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProvinceCity" class="form-label small fw-semibold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                            <input asp-for="ProvinceCity" class="form-control" placeholder="Hà Nội / TP. Hồ Chí Minh..." required />
                            <span asp-validation-for="ProvinceCity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="WardDistrict" class="form-label small fw-semibold">Quận / Huyện / Phường / Xã <span class="text-danger">*</span></label>
                            <input asp-for="WardDistrict" class="form-control" placeholder="Quận 1 / Cầu Giấy..." required />
                            <span asp-validation-for="WardDistrict" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ShippingAddress" class="form-label small fw-semibold">Địa chỉ chi tiết (Số nhà, tên đường) <span class="text-danger">*</span></label>
                            <input asp-for="ShippingAddress" class="form-control" placeholder="Số 123 đường Lê Lợi..." required />
                            <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="OrderNotes" class="form-label small fw-semibold">Ghi chú cho shipper (Nếu có)</label>
                            <textarea asp-for="OrderNotes" class="form-control" rows="2" placeholder="Giao giờ hành chính, gọi trước khi đến..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Payment Methods Section -->
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom">
                        <i class="bi bi-wallet2 text-primary me-2"></i>Phương thức thanh toán
                    </h5>

                    <div class="d-flex flex-column gap-3">
                        <!-- COD Option -->
                        <div class="border rounded-3 p-3 d-flex align-items-start gap-3 cursor-pointer">
                            <input class="form-check-input mt-1" type="radio" asp-for="PaymentMethod" value="@MyWebShop.Models.Entities.PaymentMethod.COD" id="payCod" checked />
                            <label class="form-check-label w-100" for="payCod">
                                <div class="fw-bold text-dark"><i class="bi bi-cash-stack text-success me-1"></i> Thanh toán khi nhận hàng (COD)</div>
                                <div class="text-muted small">Bạn chỉ cần thanh toán tiền mặt cho nhân viên giao hàng khi nhận được gói hàng.</div>
                            </label>
                        </div>

                        <!-- Bank Transfer Option -->
                        <div class="border rounded-3 p-3 d-flex align-items-start gap-3 cursor-pointer">
                            <input class="form-check-input mt-1" type="radio" asp-for="PaymentMethod" value="@MyWebShop.Models.Entities.PaymentMethod.BankTransfer" id="payBank" />
                            <label class="form-check-label w-100" for="payBank">
                                <div class="fw-bold text-dark"><i class="bi bi-bank text-primary me-1"></i> Chuyển khoản ngân hàng (QR Code 24/7)</div>
                                <div class="text-muted small">Quét mã QR qua ứng dụng ngân hàng hoặc ví điện tử để hoàn tất thanh toán.</div>
                                
                                <div id="bankDetailsBox" class="mt-3 p-3 bg-light rounded-3 d-none border">
                                    <div class="small fw-bold text-primary mb-1">Thông tin tài khoản nhận:</div>
                                    <div class="small text-secondary">Ngân hàng: <strong>MB Bank (Ngân Hàng Quân Đội)</strong></div>
                                    <div class="small text-secondary">Số tài khoản: <strong>090123456789</strong></div>
                                    <div class="small text-secondary">Chủ tài khoản: <strong>CONG TY CO PHAN TECHZONE</strong></div>
                                    <div class="small text-danger mt-1">Nội dung CK: <em>[Họ tên] + [Số điện thoại]</em></div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Items & Summary -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-white sticky-top" style="top: 90px;">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom">
                        Sản phẩm thanh toán (@Model.Items.Count)
                    </h5>

                    <!-- Item list -->
                    <div class="d-flex flex-column gap-3 mb-4" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var it in Model.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(it.ProductImageUrl ?? "/images/default-product.png")" alt="@it.ProductName" class="rounded object-fit-cover border" style="width: 50px; height: 50px;" />
                                    <div>
                                        <div class="fw-semibold small text-truncate" style="max-width: 200px;">@it.ProductName</div>
                                        <div class="text-muted small">SL: @it.Quantity × @it.UnitPrice.ToString("#,##0")₫</div>
                                    </div>
                                </div>
                                <div class="fw-bold small text-danger">@it.TotalPrice.ToString("#,##0")₫</div>
                            </div>
                        }
                    </div>

                    <!-- Coupon Code Input -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã giảm giá / Voucher</label>
                        <div class="input-group">
                            <input type="text" asp-for="CouponCode" class="form-control text-uppercase" placeholder="Nhập GIAM10, FREESHIP..." id="couponInput" />
                            <button type="button" class="btn btn-outline-primary" id="btnApplyCoupon" onclick="applyDiscountCoupon()">
                                Áp dụng
                            </button>
                        </div>
                        <div id="couponMessage" class="small mt-1"></div>
                    </div>

                    <hr class="my-3">

                    <!-- Price calculations -->
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Tạm tính tiền hàng:</span>
                        <strong class="text-dark">@Model.SubTotal.ToString("#,##0")₫</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Phí vận chuyển:</span>
                        <span class="text-dark" id="displayShipping">
                            @(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("#,##0") + "₫")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small text-success d-none" id="discountRow">
                        <span>Giảm giá voucher:</span>
                        <strong id="displayDiscount">-0₫</strong>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-6">Tổng cộng:</span>
                        <strong class="fs-4 text-danger fw-bold" id="displayGrandTotal">@Model.TotalAmount.ToString("#,##0")₫</strong>
                    </div>

                    <!-- Submit Order Button -->
                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-pill shadow-sm" id="btnPlaceOrder">
                        <i class="bi bi-check2-circle me-1"></i> Xác nhận đặt hàng
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle bank details when selected
        document.querySelectorAll('input[name="PaymentMethod"]').forEach(el => {
            el.addEventListener('change', function () {
                const box = document.getElementById('bankDetailsBox');
                if (this.value === '1') { // Bank transfer
                    box.classList.remove('d-none');
                } else {
                    box.classList.add('d-none');
                }
            });
        });

        // Safe submit preventing double-clicks
        function handleCheckoutSubmit(e) {
            const btn = document.getElementById('btnPlaceOrder');
            if (btn.disabled) {
                e.preventDefault();
                return false;
            }
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang tạo đơn hàng...';
            btn.disabled = true;
            return true;
        }

        // Apply Coupon AJAX
        async function applyDiscountCoupon() {
            const input = document.getElementById('couponInput');
            const code = input.value.trim();
            const msg = document.getElementById('couponMessage');
            if (!code) {
                msg.className = 'small text-danger mt-1';
                msg.innerText = 'Vui lòng nhập mã giảm giá';
                return;
            }

            try {
                const response = await fetch('/Checkout/ApplyCoupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(code)
                });
                const data = await response.json();

                if (data.success) {
                    msg.className = 'small text-success mt-1';
                    msg.innerText = data.message;
                    showToast('Đã áp dụng mã: ' + data.code, 'success');
                } else {
                    msg.className = 'small text-danger mt-1';
                    msg.innerText = data.message;
                    showToast(data.message, 'error');
                }
            } catch (e) {
                console.error(e);
            }
        }
    </script>
}
