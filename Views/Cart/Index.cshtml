@model MyWebShop.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-cart3 text-primary me-2"></i>Giỏ hàng mua sắm
            </h3>
            <span class="text-muted small">Bạn đang có <strong class="text-primary">@Model.TotalCount</strong> sản phẩm trong giỏ</span>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn sản phẩm
        </a>
    </div>

    @if (Model.Items.Any())
    {
        <div class="row g-4">
            <!-- Left: Items Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="text-muted small">
                                    <th style="min-width: 250px;">Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th style="width: 140px;">Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr id="cart-item-row-@item.Id">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(item.ProductImageUrl ?? "/images/default-product.png")" alt="@item.ProductName" class="rounded object-fit-cover border" style="width: 64px; height: 64px;" />
                                                <div>
                                                    <a asp-controller="Product" asp-action="Details" asp-route-slug="@item.ProductSlug" class="fw-bold text-dark text-decoration-none small d-block">
                                                        @item.ProductName
                                                    </a>
                                                    <span class="text-muted" style="font-size: 0.75rem;">Kho: @item.StockQuantity</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold small">@item.UnitPrice.ToString("#,##0")₫</span>
                                        </td>
                                        <td>
                                            <div class="qty-group">
                                                <button type="button" class="qty-btn" onclick="updateItemQuantity(@item.Id, @(item.Quantity - 1), 'cart-item-row-@item.Id')">-</button>
                                                <input type="number" class="qty-input" value="@item.Quantity" readonly />
                                                <button type="button" class="qty-btn" onclick="updateItemQuantity(@item.Id, @(item.Quantity + 1), 'cart-item-row-@item.Id')" @(item.Quantity >= item.StockQuantity ? "disabled" : "")>+</button>
                                            </div>
                                        </td>
                                        <td>
                                            <strong class="text-danger small" id="line-total-@item.Id">
                                                @item.TotalPrice.ToString("#,##0")₫
                                            </strong>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-light btn-sm text-danger rounded-circle p-2" title="Xóa sản phẩm" onclick="removeCartItem(@item.Id, 'cart-item-row-@item.Id')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 bg-light d-flex justify-content-between align-items-center">
                        <form asp-action="ClearCart" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tất cả sản phẩm trong giỏ?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash3 me-1"></i> Xóa toàn bộ giỏ hàng
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary Card -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-white sticky-top" style="top: 90px;">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom">Tóm tắt đơn hàng</h5>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Tạm tính tiền hàng:</span>
                        <strong class="text-dark" id="cart-subtotal">@Model.SubTotal.ToString("#,##0")₫</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Phí vận chuyển dự kiến:</span>
                        <span class="text-dark" id="cart-shipping">
                            @(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("#,##0") + "₫")
                        </span>
                    </div>

                    <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>Freeship cho đơn hàng từ <strong>10.000.000₫</strong></span>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-6">Tổng thanh toán:</span>
                        <strong class="fs-4 text-danger fw-bold" id="cart-grandtotal">@Model.GrandTotal.ToString("#,##0")₫</strong>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary w-100 py-3 fw-bold rounded-pill shadow-sm mb-2">
                        <i class="bi bi-credit-card me-1"></i> Tiến hành đặt hàng ngay
                    </a>

                    <p class="text-center text-muted small mt-2 mb-0">
                        <i class="bi bi-lock-fill me-1"></i> Thanh toán an toàn & bảo mật 100%
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm p-5 rounded-4 text-center bg-white my-4">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px;">
                <i class="bi bi-cart-x text-muted" style="font-size: 3rem;"></i>
            </div>
            <h4 class="fw-bold mb-2">Giỏ hàng của bạn đang trống</h4>
            <p class="text-muted small mb-4">Không có sản phẩm nào trong giỏ hàng. Hãy khám phá và mua sắm ngay!</p>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">
                    <i class="bi bi-shop me-1"></i> Mua sắm ngay bây giờ
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateItemQuantity(cartItemId, newQty, rowId) {
            updateCartItemQuantity(cartItemId, newQty, rowId);
        }
    </script>
}
