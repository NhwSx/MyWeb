@model MyWebShop.Models.Entities.Product

<div class="product-card">
    <div class="product-thumb-container">
        <a asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug">
            <img src="@(Model.MainImageUrl ?? "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80")" 
                 alt="@Model.Name" 
                 class="product-thumb" 
                 loading="lazy" />
        </a>

        @if (Model.DiscountPercentage > 0)
        {
            <div class="badge-sale">-@Model.DiscountPercentage%</div>
        }

        @if (Model.IsNew)
        {
            <div class="badge-tag">MỚI</div>
        }
        else if (Model.IsBestSeller)
        {
            <div class="badge-tag" style="background: rgba(234, 88, 12, 0.85);">BÁN CHẠY</div>
        }
    </div>

    <div class="product-body">
        <div class="product-category-name">
            @(Model.Category?.Name ?? "Công nghệ")
        </div>

        <a asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug" class="product-title" title="@Model.Name">
            @Model.Name
        </a>

        <div class="product-rating">
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= Math.Round(Model.RatingAverage))
                {
                    <i class="bi bi-star-fill"></i>
                }
                else
                {
                    <i class="bi bi-star text-muted"></i>
                }
            }
            <span class="rating-text">(@Model.ReviewCount)</span>
            <span class="text-muted ms-auto" style="font-size: 0.75rem;">
                @(Model.IsInStock ? $"Còn {Model.StockQuantity}" : "Hết hàng")
            </span>
        </div>

        <div class="product-price-row">
            <span class="price-current">@Model.Price.ToString("#,##0")₫</span>
            @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
            {
                <span class="price-original">@Model.OriginalPrice.Value.ToString("#,##0")₫</span>
            }
        </div>

        <div class="product-actions mt-auto">
            @if (Model.IsInStock)
            {
                <button type="button" class="btn-add-cart" onclick="addToCart(@Model.Id, 1, this)">
                    <i class="bi bi-cart-plus"></i> Thêm giỏ
                </button>
                <a asp-controller="Checkout" asp-action="BuyNow" asp-route-productId="@Model.Id" asp-route-quantity="1" class="btn-buy-now">
                    <i class="bi bi-bag-check-fill me-1"></i> Mua ngay
                </a>
            }
            else
            {
                <button type="button" class="btn btn-secondary w-100 btn-sm disabled" disabled>
                    Tạm hết hàng
                </button>
            }
        </div>
    </div>
</div>
