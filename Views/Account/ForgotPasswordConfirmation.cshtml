@{
    ViewData["Title"] = "Xác nhận yêu cầu khôi phục mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-card p-4 p-md-5 text-center" style="border-radius: 20px;">
                <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-envelope-check-fill fs-1"></i>
                </div>
                <h3 class="fw-bold mb-2">Đã tạo yêu cầu khôi phục!</h3>
                <p class="text-secondary mb-4">
                    @ViewBag.Message
                </p>

                @if (!string.IsNullOrEmpty(ViewBag.ResetLink))
                {
                    <div class="alert alert-light border p-3 text-start mb-4 rounded-3">
                        <div class="fw-semibold small text-primary mb-1">
                            <i class="bi bi-info-circle-fill me-1"></i> Liên kết đặt lại mật khẩu của bạn:
                        </div>
                        <a href="@ViewBag.ResetLink" class="text-break small fw-bold text-decoration-none">
                            @ViewBag.ResetLink
                        </a>
                        <div class="mt-3">
                            <a href="@ViewBag.ResetLink" class="btn btn-sm btn-primary w-100">
                                Nhấp vào đây để đổi mật khẩu ngay
                            </a>
                        </div>
                    </div>
                }

                <div>
                    <a asp-action="Login" class="btn btn-outline-secondary px-4">
                        Quay lại Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
