@model MyWebShop.Models.Entities.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xử lý đơn hàng: " + Model.OrderCode;
}

<div class="mb-4">
    <a asp-action="Orders" class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-3">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đơn hàng
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h4 class="fw-bold mb-1">Chi tiết đơn hàng: <span class="text-primary">@Model.OrderCode</span></h4>
            <span class="text-muted small">Thời gian tạo: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
        </div>
        <div>
            <span class="badge @Model.StatusBadgeClass fs-6 px-3 py-2 rounded-pill">
                @Model.StatusDisplayName
            </span>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left: Status update controllers -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h5 class="fw-bold mb-3 pb-2 border-bottom">Cập nhật trạng thái đơn</h5>

            <form asp-action="UpdateOrderStatus" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <label class="form-label small fw-semibold">Chuyển trạng thái xử lý:</label>
                <div class="input-group">
                    <select name="status" class="form-select">
                        <option value="0" selected="@(Model.Status == MyWebShop.Models.Entities.OrderStatus.Pending)">Chờ xác nhận</option>
                        <option value="1" selected="@(Model.Status == MyWebShop.Models.Entities.OrderStatus.Confirmed)">Đã xác nhận</option>
                        <option value="2" selected="@(Model.Status == MyWebShop.Models.Entities.OrderStatus.Preparing)">Đang chuẩn bị</option>
                        <option value="3" selected="@(Model.Status == MyWebShop.Models.Entities.OrderStatus.Shipping)">Đang giao hàng</option>
                        <option value="4" selected="@(Model.Status == MyWebShop.Models.Entities.OrderStatus.Delivered)">Đã giao (Thành công)</option>
                        <option value="5" selected="@(Model.Status == MyWebShop.Models.Entities.OrderStatus.Cancelled)">Đã hủy</option>
                    </select>
                    <button type="submit" class="btn btn-primary fw-semibold">Cập nhật</button>
                </div>
                <div class="text-muted" style="font-size: 0.75rem; margin-top: 4px;">
                    * Lưu ý: Khi chuyển sang "Đã hủy", số lượng sản phẩm sẽ tự động được hoàn lại về kho.
                </div>
            </form>

            <form asp-action="UpdatePaymentStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <label class="form-label small fw-semibold">Cập nhật trạng thái thanh toán:</label>
                <div class="input-group">
                    <select name="paymentStatus" class="form-select">
                        <option value="0" selected="@(Model.PaymentStatus == MyWebShop.Models.Entities.PaymentStatus.Unpaid)">Chưa thanh toán</option>
                        <option value="1" selected="@(Model.PaymentStatus == MyWebShop.Models.Entities.PaymentStatus.Paid)">Đã thanh toán</option>
                    </select>
                    <button type="submit" class="btn btn-success fw-semibold">Lưu thanh toán</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right: Customer Info -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h5 class="fw-bold mb-3 pb-2 border-bottom">Thông tin nhận hàng</h5>
            <div class="small">
                <div class="mb-2">Họ và tên: <strong class="text-dark">@Model.CustomerName</strong></div>
                <div class="mb-2">Số điện thoại: <strong class="text-dark">@Model.CustomerPhone</strong></div>
                <div class="mb-2">Email: <strong class="text-dark">@Model.CustomerEmail</strong></div>
                <div class="mb-2">Địa chỉ giao: <span class="text-secondary">@Model.ShippingAddress, @Model.WardDistrict, @Model.ProvinceCity</span></div>
                <div class="mb-2">Hình thức thanh toán: <strong>@Model.PaymentMethod</strong></div>
                @if (!string.IsNullOrEmpty(Model.OrderNotes))
                {
                    <div class="p-2 bg-light rounded mt-2 text-muted">
                        <em>Ghi chú: @Model.OrderNotes</em>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Products Table -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <h5 class="fw-bold mb-3 pb-2 border-bottom">Danh sách sản phẩm trong đơn</h5>
    <div class="table-responsive">
        <table class="table align-middle small mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="width: 60px;">Ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var it in Model.Items)
                {
                    <tr>
                        <td>
                            <img src="@(it.ProductImageUrl ?? "/images/default-product.png")" alt="@it.ProductName" class="rounded object-fit-cover border" style="width: 44px; height: 44px;" />
                        </td>
                        <td>
                            <div class="fw-bold">@it.ProductName</div>
                        </td>
                        <td>@it.UnitPrice.ToString("#,##0")₫</td>
                        <td>@it.Quantity</td>
                        <td class="text-end fw-bold text-danger">@it.TotalPrice.ToString("#,##0")₫</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end">Tiền hàng:</td>
                    <td class="text-end fw-semibold">@Model.SubTotal.ToString("#,##0")₫</td>
                </tr>
                <tr>
                    <td colspan="4" class="text-end">Phí giao hàng:</td>
                    <td class="text-end">@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("#,##0") + "₫")</td>
                </tr>
                @if (Model.DiscountAmount > 0)
                {
                    <tr>
                        <td colspan="4" class="text-end text-success">Giảm giá:</td>
                        <td class="text-end text-success">-@Model.DiscountAmount.ToString("#,##0")₫</td>
                    </tr>
                }
                <tr class="fs-6">
                    <td colspan="4" class="text-end fw-bold">Tổng thanh toán:</td>
                    <td class="text-end fw-bold text-danger">@Model.TotalAmount.ToString("#,##0")₫</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
