@model List<MyWebShop.Models.Entities.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý sản phẩm";
    var categories = ViewBag.Categories as List<MyWebShop.Models.Entities.Category> ?? new();
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <!-- Top actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1">Danh sách sản phẩm (@Model.Count)</h4>
            <p class="text-muted small mb-0">Quản lý kho hàng, giá bán và thông tin sản phẩm trong cửa hàng</p>
        </div>
        <a asp-action="CreateProduct" class="btn btn-primary fw-bold px-4 py-2 rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
        </a>
    </div>

    <!-- Search & Filter Form -->
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Tìm kiếm theo tên hoặc mã SKU..." value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select">
                <option value="">-- Tất cả danh mục --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id" selected="@(ViewBag.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary w-100 fw-semibold">Lọc dữ liệu</button>
            <a asp-action="Products" class="btn btn-light border px-3" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table align-middle table-hover small">
            <thead class="bg-light">
                <tr>
                    <th style="width: 70px;">Hình ảnh</th>
                    <th>Tên sản phẩm & SKU</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th>Trạng thái</th>
                    <th style="width: 140px;" class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prod in Model)
                {
                    <tr>
                        <td>
                            <img src="@(prod.MainImageUrl ?? "/images/default-product.png")" alt="@prod.Name" class="rounded object-fit-cover border" style="width: 50px; height: 50px;" />
                        </td>
                        <td>
                            <a asp-controller="Product" asp-action="Details" asp-route-slug="@prod.Slug" target="_blank" class="fw-bold text-dark text-decoration-none d-block">
                                @prod.Name
                            </a>
                            <span class="text-muted" style="font-size: 0.75rem;">SKU: <code class="text-primary">@prod.Sku</code></span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @(prod.Category?.Name ?? "Không")
                            </span>
                        </td>
                        <td>
                            <strong class="text-danger">@prod.Price.ToString("#,##0")₫</strong>
                            @if (prod.OriginalPrice.HasValue)
                            {
                                <div class="text-muted" style="font-size: 0.7rem; text-decoration: line-through;">
                                    @prod.OriginalPrice.Value.ToString("#,##0")₫
                                </div>
                            }
                        </td>
                        <td>
                            @if (prod.StockQuantity <= 0)
                            {
                                <span class="badge bg-danger">Hết hàng (0)</span>
                            }
                            else if (prod.StockQuantity <= 15)
                            {
                                <span class="badge bg-warning text-dark">Sắp hết (@prod.StockQuantity)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Còn hàng (@prod.StockQuantity)</span>
                            }
                        </td>
                        <td>
                            @if (prod.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Đã ẩn</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="EditProduct" asp-route-id="@prod.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteProduct" asp-route-id="@prod.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn ẩn sản phẩm này khỏi cửa hàng?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Ẩn/Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
